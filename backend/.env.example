# =====================================================================
# Copy this file to `.env` (or export these as real environment
# variables / set them in your deployment platform's config) before
# running the backend. Nothing in application.yml is hardcoded -
# everything below has a sensible local-dev default except secrets.
# =====================================================================

# ---- Server ----
SERVER_PORT=8080

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=appointment_manager
DB_USERNAME=root
DB_PASSWORD=root

# ---- JWT ----
# Generate a real random 256-bit+ secret for production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-must-be-at-least-256-bits-long-please
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Email (SMTP) ----
# The doc asks for a dedicated email service (SendGrid/Mailgun/similar) rather
# than raw personal email. Recommended: Brevo - a genuine permanent free
# tier (300 emails/day, no card, no trial expiry), same category as
# SendGrid/Mailgun. Works with zero code changes since the backend uses
# Spring Mail (JavaMailSender), the Java equivalent of Nodemailer - both are
# just SMTP clients that work with any provider you point them at.
#
# Brevo setup (free): sign up at https://app.brevo.com -> Settings -> SMTP &
# API -> SMTP tab for your host/port/login/key -> verify a sender
# email/domain in the dashboard (a click-to-verify, not a real mailbox you
# need to own).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@example.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_FROM=your-verified-sender@example.com
MAIL_MAX_RETRIES=5

# ---- Alternative: Gmail SMTP ----
# Simpler to set up if you'd rather not create a Brevo account, but Gmail
# isn't really "an email service" in the sense the doc means - it's your
# personal provider's SMTP, reused. If you go this route, create a
# throwaway Gmail account (don't use your personal one), enable 2-Step
# Verification, generate an App Password at
# https://myaccount.google.com/apppasswords (NEVER your real account
# password), and Gmail requires MAIL_FROM to match MAIL_USERNAME:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-throwaway-project-email@gmail.com
#   MAIL_PASSWORD=your-16-char-app-password
#   MAIL_FROM=your-throwaway-project-email@gmail.com

# ---- Slot hold duration ----
SLOT_HOLD_MINUTES=5

# ---- LLM ----
# Choose your provider: "gemini" (default - genuinely free, no card, no expiry
# on Flash models - get a key at https://aistudio.google.com/apikey),
# "groq" (also free, extremely fast inference - get a key at
# https://console.groq.com/keys), or "anthropic" (best quality, one-time ~$5
# trial credit - get a key at https://console.anthropic.com/). Only the key
# for your chosen provider needs to be filled in; the others can stay blank.
LLM_PROVIDER=gemini
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Google Calendar OAuth2 ----
# Create OAuth 2.0 credentials (Web application) in Google Cloud Console,
# enable the Google Calendar API, and add the redirect URI below to the
# credential's "Authorized redirect URIs".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
